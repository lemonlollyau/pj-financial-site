{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/index.php/home", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },

    { "source": "/index.php/about-us", "destination": "/about", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/index.php/about-us/directors", "destination": "/team", "permanent": true },
    { "source": "/about-us/directors", "destination": "/team", "permanent": true },
    { "source": "/directors", "destination": "/team", "permanent": true },
    { "source": "/index.php/about-us/team-members", "destination": "/team", "permanent": true },
    { "source": "/about-us/team-members", "destination": "/team", "permanent": true },
    { "source": "/team-members", "destination": "/team", "permanent": true },
    { "source": "/index.php/testimonials", "destination": "/testimonials", "permanent": true },

    { "source": "/index.php/services", "destination": "/#finance", "permanent": true },
    { "source": "/services", "destination": "/#finance", "permanent": true },
    { "source": "/index.php/lenders", "destination": "/about#lenders", "permanent": true },
    { "source": "/lenders", "destination": "/about#lenders", "permanent": true },

    { "source": "/index.php/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },

    { "source": "/index.php/loan-calculator", "destination": "/calculator", "permanent": true },
    { "source": "/index.php/home-loan-calculator", "destination": "/calculator", "permanent": true },
    { "source": "/loan-calculator", "destination": "/calculator", "permanent": true },
    { "source": "/home-loan-calculator", "destination": "/calculator", "permanent": true },

    { "source": "/index.php/privacy-policy-dispute-resolution", "destination": "/privacy", "permanent": true },
    { "source": "/privacy-policy-dispute-resolution", "destination": "/privacy", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/wp-content/uploads/2021/03/P-J-Financial-Solutions-Privacy-Policy.pdf", "destination": "/privacy", "permanent": true },
    { "source": "/wp-content/uploads/2021/03/P-J-Financial-Solutions-Dispute-Resolution-Process-1-October-2018.pdf", "destination": "/privacy", "permanent": true },

    { "source": "/sitemap_index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/index.php/feed", "destination": "/", "permanent": true },
    { "source": "/feed", "destination": "/", "permanent": true },

    { "source": "/index.php/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-content/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-includes/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-login.php", "destination": "/", "permanent": false },
    { "source": "/xmlrpc.php", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
